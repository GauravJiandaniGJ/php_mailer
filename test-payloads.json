  "custom_template_with_html": {
    "to": ["customer@example.com"],
    "from": "notifications@yourapp.com",
    "subject": "Custom Notification",
    "template_type": "custom",
    "html_content": "<!DOCTYPE html><html><body><h1>Hello {{name}}!</h1><p>{{custom_message}}</p><p>Sent on {{timestamp}}</p></body></html>",
    "data": {
      "name": "Alex Smith",
      "custom_message": "This is a custom email template with dynamic content."
    }
  },

  "custom_template_with_file": {
    "to": ["user@example.com"],
    "from": "system@yourapp.com", 
    "subject": "System Notification",
    "template_type": "custom",
    "template_id": "notification",
    "data": {
      "user_name": "Mike Wilson",
      "notification_type": "Account Update",
      "details": "Your account settings have been successfully updated."
    }
  },

  "minimal_reset_password": {
